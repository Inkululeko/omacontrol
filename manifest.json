{
  "schemaVersion": 1,
  "id": "io.github.twiking.omacontrol",
  "name": "OmaControl",
  "version": "1.3.0",
  "author": "Tobias Wiking",
  "license": "MIT",
  "description": "One window for every Omarchy setting, from Hyprland to your keybindings to tmux. Searchable, and anything you change can be put back.",
  "homepage": "https://github.com/twiking/omacontrol",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "OmaControl",
    "description": "Opens the OmaControl window.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
