{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash -n:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(journalctl --user --since:*)",
      "Bash(hyprctl -j monitors)",
      "Bash(hyprctl -j clients)",
      "Bash(hyprctl -j devices)",
      "Bash(hyprctl monitors:*)",
      "Bash(hyprctl devices:*)",
      "Bash(hyprctl layers -j)",
      "Bash(omarchy plugin validate:*)",
      "Bash(desktop-file-validate:*)",
      "Bash(/usr/lib/qt6/bin/qmllint:*)",
      "Bash(.claude/skills/omacontrol-testing/scripts/lint-qml.sh)",
      "Bash(.claude/skills/omacontrol-testing/scripts/state-diff.sh:*)",
      "Bash(.claude/skills/omacontrol-testing/scripts/shot.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-hyprctl-keyword.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/after-edit.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/needs-restart.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
